   "source": [
    "# Install and import MySQL.\n",
    "# pip install pymysql if it's not installed on your device.\n",
    "import pymysql\n",
    "from datetime import datetime # For getting today's date for attendance.\n",
    "\n",
    "# Connect to MySQL.\n",
    "Conn = pymysql.connect(host = \"localhost\" , user = \"root\" , password = \"12345\" , database = \"Anshul\")\n",
    "\n",
    "# Create Cursor.\n",
    "Cur = Conn.cursor()\n",
    "\n",
    "# Create Tables.\n",
    "Cur.execute(\"Create table if not exists Vidhyarthi(ID int auto_increment primary key , Name varchar(30) , Roll_Number int)\")\n",
    "Cur.execute(\"Create table if not exists Attendance(ID int auto_increment primary key , Student_ID int , Attendance_Date Datetime , Status varchar(30))\")\n",
    "\n",
    "while True: # Variable for menu choice.\n",
    "\n",
    "    print(\"\\n===== ATTENDANCE SYSTEM =====\")\n",
    "    print(\"1. Add Student.\")\n",
    "    print(\"2. Mark Attendance.\")\n",
    "    print(\"3. View Attendance.\")\n",
    "    print(\"4. Exit.\")\n",
    "\n",
    "    Choice = int(input(\"Enter your Choice :\"))\n",
    "\n",
    "    # 1. Add Student.\n",
    "    if Choice == 1:\n",
    "        Name = input(\"Enter Student name :\")\n",
    "        Roll_Number = int(input(\"Enter Roll_Number :\"))\n",
    "\n",
    "        Cur.execute(f\"Insert into Vidhyarthi (Name , Roll_Number) VALUES ('{Name}', {Roll_Number})\")\n",
    "        Conn.commit()\n",
    "\n",
    "        print(\"Student Added Successfully!\")\n",
    "\n",
    "    # 2. Mark Attendance.\n",
    "    elif Choice == 2:\n",
    "        Roll_Number = int(input(\"Enter Roll_Number :\"))\n",
    "\n",
    "        # Fetch student ID using roll number.\n",
    "        Cur.execute(f\"Select ID from Vidhyarthi where Roll_Number = {Roll_Number}\")\n",
    "        Result = Cur.fetchone()\n",
    "\n",
    "        if Result:\n",
    "            Status = input(\"Enter Status (Present/Absent) :\")\n",
    "\n",
    "            print(\"1. Today's Date.\")\n",
    "            print(\"2. Custom Date.\")\n",
    "            Date_choice = int(input(\"Choose option :\"))\n",
    "\n",
    "            # Insert attendance record with today's date.\n",
    "            if Date_choice == 1:\n",
    "                Attendance_Date = datetime.now()\n",
    "            \n",
    "            # Insert attandance record with your's given date.\n",
    "            elif Date_choice == 2:\n",
    "                Attendance_Date = input(\"Enter date (YYYY-MM-DD) :\")\n",
    "            else:\n",
    "                Attendance_Date = datetime.now()\n",
    "\n",
    "            Cur.execute(f\"Insert into Attendance (Student_ID , Attendance_Date , Status) VALUES ({Result[0]} , '{Attendance_Date}' , '{Status}')\")\n",
    "            Conn.commit()\n",
    "\n",
    "            print(\"Attendance Marked Successfully!\")\n",
    "        else:\n",
    "            print(\"Student Not Found!\")\n",
    "\n",
    "    # 3. View Attendance.\n",
    "    elif Choice == 3:\n",
    "        Cur.execute(\"Select Vidhyarthi.Name , Vidhyarthi.Roll_Number , Attendance.Attendance_Date , Attendance.Status from Attendance join Vidhyarthi on Attendance.Student_ID = Vidhyarthi.ID\")\n",
    "        Records = Cur.fetchall()\n",
    "\n",
    "        print(\"\\nAttendance Records\")\n",
    "        print(\"----------------------------\")\n",
    "\n",
    "        for Row in Records:\n",
    "            print(\"Name     :\", Row[0])\n",
    "            print(\"Roll_No  :\", Row[1])\n",
    "            print(\"Date     :\", Row[2])\n",
    "            print(\"Status   :\", Row[3])\n",
    "            print(\"----------------------------\")\n",
    "\n",
    "    # 4. Exit.\n",
    "    elif Choice == 4:\n",
    "        print(\"Program Closed.\")\n",
    "        break\n",
    "\n",
    "    else:\n",
    "        print(\"Invalid Choice!\")\n",
    "\n",
    "Conn.close()"
